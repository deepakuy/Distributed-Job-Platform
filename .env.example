# Application
APP_NAME="Distributed Job Platform"
APP_ENV="development" # development, production, testing
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security
# Run: openssl rand -hex 32
JWT_SECRET_KEY="supersecretchangeitinproduction"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# For local running outside docker, use localhost
# For running inside docker compose, use postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/job_platform"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Worker
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL=5
WORKER_LEASE_DURATION=15
WORKER_REAPER_INTERVAL=10

# Rate Limiting
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW=60
